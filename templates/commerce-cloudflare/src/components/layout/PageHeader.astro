---
interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
}

const { title, eyebrow, lede } = Astro.props;
---
<header class="commerce-page-header">
  {eyebrow && <p class="commerce-eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class="commerce-page-header__lede">{lede}</p>}
  <slot />
</header>
