---
import { Image, PortableText } from "emdash/ui";
import type { CmsPageEntry } from "../lib/cms";
import { loadPageLayout } from "../lib/cms";
import ComposerSections from "./ComposerSections.astro";

interface Props {
  page: CmsPageEntry;
}

const { page } = Astro.props;
const image = page.data.featured_image;
const imageSource = image && ("url" in image ? image.url : "src" in image ? image.src : undefined);
const layout = await loadPageLayout(page.id, Astro.url, Astro.locals.emdash?.handlePublicPluginApiRoute);
---
<article class="cms-page" data-cms-collection="pages" data-cms-slug={page.id}>
  <h1 {...(page.edit?.title ?? {})}>{page.data.title ?? page.id}</h1>
  {imageSource && (
    <div class="cms-page-media" {...(page.edit?.featured_image ?? {})}>
      <Image image={image as never} />
    </div>
  )}
  {layout ? <ComposerSections layout={layout} /> : (
    <div class="cms-page-content" {...(page.edit?.content ?? {})}>
      {page.data.content ? <PortableText value={page.data.content as never} /> : <p>This page has no published content yet.</p>}
    </div>
  )}
</article>
