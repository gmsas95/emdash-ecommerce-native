---
import Base from "../../layouts/Base.astro";
import ClientCatalog from "../../components/ClientCatalog.astro";
import DemoNotice from "../../components/DemoNotice.astro";
---
<Base title="Shop" description="Browse the starter collection.">
  <div class="page-wrap section shop-page">
    <div class="shop-intro">
      <p class="section-eyebrow">The collection</p>
      <h1>Useful things, thoughtfully chosen.</h1>
      <p class="lede">Explore the starter catalog and replace these demo values with your own products, imagery, and pricing in Commerce admin.</p>
    </div>
    <DemoNotice />
    <ClientCatalog id="shop-products" />
  </div>
</Base>
