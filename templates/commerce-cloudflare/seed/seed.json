{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "EmDash Commerce Starter",
    "description": "A neutral, product-first storefront starter for EmDash Commerce.",
    "author": "Local Codex"
  },
  "settings": {
    "title": "EmDash Commerce Starter",
    "tagline": "Thoughtful goods for everyday rituals.",
    "logo": {
      "$media": {
        "url": "/media/demo/mark.svg",
        "alt": "EmDash Commerce Starter mark",
        "filename": "starter-mark.svg"
      }
    }
  },
  "collections": [
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "urlPattern": "/{slug}",
      "supports": ["drafts", "revisions", "search", "seo"],
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
        { "slug": "featured_image", "label": "Featured Image", "type": "image" },
        { "slug": "content", "label": "Content", "type": "portableText", "searchable": true }
      ]
    },
    {
      "slug": "story_blocks",
      "label": "Story Blocks",
      "labelSingular": "Story Block",
      "supports": ["drafts", "revisions", "search"],
      "fields": [
        { "slug": "kicker", "label": "Kicker", "type": "string", "searchable": true },
        { "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
        { "slug": "image", "label": "Image", "type": "image" },
        { "slug": "content", "label": "Content", "type": "portableText", "searchable": true },
        { "slug": "sort_order", "label": "Sort Order", "type": "integer", "required": true }
      ]
    },
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "supports": ["drafts", "revisions", "search", "seo"],
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
        { "slug": "featured_image", "label": "Featured Image", "type": "image" },
        { "slug": "content", "label": "Content", "type": "portableText", "searchable": true },
        { "slug": "excerpt", "label": "Excerpt", "type": "text" }
      ]
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Primary Navigation",
      "items": [
        { "type": "custom", "label": "Home", "url": "/" },
        { "type": "custom", "label": "Shop", "url": "/shop" },
        { "type": "custom", "label": "Our approach", "url": "/about" },
        { "type": "custom", "label": "Journal", "url": "/posts" },
        { "type": "custom", "label": "Contact", "url": "/contact" }
      ]
    },
    {
      "name": "footer",
      "label": "Footer Navigation",
      "items": [
        { "type": "custom", "label": "Shipping & returns", "url": "/shipping-returns" },
        { "type": "custom", "label": "Privacy", "url": "/privacy" },
        { "type": "custom", "label": "Terms", "url": "/terms" },
        { "type": "custom", "label": "Contact", "url": "/contact" }
      ]
    }
  ],
  "widgetAreas": [],
  "sections": [
    {
      "slug": "starter-hero",
      "title": "Starter hero",
      "description": "A flexible split hero for the home page.",
      "keywords": ["hero", "welcome", "collection"],
      "source": "theme",
      "content": [
        { "_type": "block", "style": "h1", "children": [{ "_type": "span", "text": "Thoughtful goods for everyday rituals." }] },
        { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "A focused collection with clear details, useful objects, and an easy way to choose well." }] }
      ]
    },
    {
      "slug": "starter-approach",
      "title": "Starter approach",
      "description": "A bounded editorial section for an about page.",
      "keywords": ["approach", "story", "values"],
      "source": "theme",
      "content": [
        { "_type": "block", "style": "h2", "children": [{ "_type": "span", "text": "A considered approach" }] },
        { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "We keep the collection focused, the information clear, and the experience straightforward from first look to checkout." }] }
      ]
    },
    {
      "slug": "starter-products",
      "title": "Starter products",
      "description": "Product-family introduction for a commerce storefront.",
      "keywords": ["products", "collection", "essentials"],
      "source": "theme",
      "content": [
        { "_type": "block", "style": "h2", "children": [{ "_type": "span", "text": "The collection" }] },
        { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "Explore everyday essentials, considered gifts, and small details that make routines feel more your own." }] }
      ]
    }
  ],
  "content": {
    "pages": [
      {
        "id": "home",
        "slug": "home",
        "status": "published",
        "data": {
          "title": "Thoughtful goods for everyday rituals.",
          "featured_image": {
            "$media": {
              "url": "/media/demo/hero.svg",
              "alt": "A calm arrangement of selected goods",
              "filename": "starter-hero.svg"
            }
          },
          "content": [
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "A focused collection of useful, considered products for the moments that make up your day." }] },
            { "_type": "block", "style": "h2", "children": [{ "_type": "span", "text": "Choose well, simply" }] },
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "Browse clear product details, compare available options, and build a cart that fits your plans." }] }
          ]
        }
      },
      {
        "id": "about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "Our approach",
          "featured_image": {
            "$media": {
              "url": "/media/demo/story-roots.svg",
              "alt": "Leaves and a simple vessel",
              "filename": "starter-story-roots.svg"
            }
          },
          "content": [
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "We believe a good storefront should make the right information easy to find and the next step easy to take." }] },
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "This starter keeps the structure focused so each store can bring its own products, voice, and story to the experience." }] }
          ]
        }
      },
      {
        "id": "contact",
        "slug": "contact",
        "status": "published",
        "data": {
          "title": "Get in touch",
          "content": [
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "Questions about an order, a product, or the collection? Send a message and the store team will get back to you." }] },
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "Email: hello@example.com" }] }
          ]
        }
      },
      {
        "id": "shipping-returns",
        "slug": "shipping-returns",
        "status": "published",
        "data": {
          "title": "Shipping & returns",
          "content": [
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "Delivery options, rates, and estimated windows are confirmed for your address at checkout. This starter uses demo catalog values until the operator replaces them in Commerce admin." }] },
            { "_type": "block", "style": "h2", "children": [{ "_type": "span", "text": "Returns" }] },
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "Contact the store before sending an item back. Include your order ID and the email used at checkout so support can confirm eligibility and next steps." }] }
          ]
        }
      },
      {
        "id": "checkout",
        "slug": "checkout",
        "status": "published",
        "data": {
          "title": "Review your order",
          "content": [
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "Commerce confirms availability and recalculates the total before payment. Enter your delivery details, choose an available payment method, and continue securely." }] },
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "Payment details are handled by the selected payment provider. This storefront does not store card details." }] }
          ]
        }
      },
      {
        "id": "privacy",
        "slug": "privacy",
        "status": "published",
        "data": {
          "title": "Privacy",
          "content": [
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "We use the information you provide to process orders, communicate about delivery, prevent fraud, and provide support. Payment details are entered on the selected provider's hosted checkout and are not stored by this storefront." }] }
          ]
        }
      },
      {
        "id": "terms",
        "slug": "terms",
        "status": "published",
        "data": {
          "title": "Terms",
          "content": [
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "By placing an order, you confirm that your delivery details are accurate and that you are authorized to use the selected payment method. Prices and availability are confirmed by Commerce at checkout." }] }
          ]
        }
      }
    ],
    "story_blocks": [
      {
        "id": "roots",
        "slug": "roots",
        "status": "published",
        "data": {
          "kicker": "01 / The starting point",
          "title": "Start with what matters.",
          "image": {
            "$media": {
              "url": "/media/demo/story-roots.svg",
              "alt": "Leaves and a simple vessel",
              "filename": "starter-story-roots.svg"
            }
          },
          "content": [
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "Every collection begins with a point of view: fewer distractions, better details, and products that earn their place." }] }
          ],
          "sort_order": 10
        }
      },
      {
        "id": "craft",
        "slug": "craft",
        "status": "published",
        "data": {
          "kicker": "02 / The details",
          "title": "Good design feels natural.",
          "image": {
            "$media": {
              "url": "/media/demo/story-craft.svg",
              "alt": "Hands working with simple materials",
              "filename": "starter-story-craft.svg"
            }
          },
          "content": [
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "Clear navigation, honest descriptions, and an accessible path to checkout leave more room for the things you came to find." }] }
          ],
          "sort_order": 20
        }
      },
      {
        "id": "care",
        "slug": "care",
        "status": "published",
        "data": {
          "kicker": "03 / Make it yours",
          "title": "Built to become your store.",
          "image": {
            "$media": {
              "url": "/media/demo/story-care.svg",
              "alt": "Collected objects ready to share",
              "filename": "starter-story-care.svg"
            }
          },
          "content": [
            { "_type": "block", "style": "normal", "children": [{ "_type": "span", "text": "Replace the starter copy, catalog, and imagery with your own identity while keeping the Commerce routes and behavior intact." }] }
          ],
          "sort_order": 30
        }
      }
    ]
  }
}
