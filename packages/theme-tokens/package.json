{
  "name": "@emdash-cms/theme-tokens",
  "version": "0.1.0",
  "description": "Validated, bounded theme tokens for EmDash storefronts.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./admin": {
      "development": "./src/admin.tsx",
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js",
      "default": "./dist/admin.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist --rootDir src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "peerDependencies": {
    "emdash": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
