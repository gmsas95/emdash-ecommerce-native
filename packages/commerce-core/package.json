{
  "name": "@emdash-commerce/core",
  "version": "0.2.0",
  "description": "Native EmDash Commerce Core plugin, bridge, admin pages, and storefront client.",
  "license": "MIT",
  "repository": "https://github.com/gmsas95/emdash-commerce-core",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./admin": {
      "development": "./src/admin.tsx",
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js",
      "default": "./dist/admin.js"
    },
    "./storefront/client": {
      "development": "./src/storefront/client.ts",
      "types": "./dist/storefront/client.d.ts",
      "import": "./dist/storefront/client.js",
      "default": "./dist/storefront/client.js"
    },
    "./storefront/types": {
      "development": "./src/storefront/types.ts",
      "types": "./dist/storefront/types.d.ts",
      "import": "./dist/storefront/types.js",
      "default": "./dist/storefront/types.js"
    },
    "./domain/*": {
      "development": "./src/domain/*.ts",
      "types": "./dist/domain/*.d.ts",
      "import": "./dist/domain/*.js",
      "default": "./dist/domain/*.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist --rootDir src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@gmsas95/emdash-commerce-contracts": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "emdash": ">=0.33.0",
    "react": ">=18"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
