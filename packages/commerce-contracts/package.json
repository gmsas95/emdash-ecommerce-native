{
  "name": "@gmsas95/emdash-commerce-contracts",
  "version": "0.1.2",
  "description": "Versioned provider-neutral Commerce domain and bridge contracts for EmDash.",
  "license": "MIT",
  "repository": "https://github.com/gmsas95/emdash-commerce-core",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist --rootDir src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "devDependencies": {
    "vitest": "catalog:"
  }
}
